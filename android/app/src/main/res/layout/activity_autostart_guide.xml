<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── En-tête explicatif ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Pourquoi configurer ça ?"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sur Xiaomi, Huawei, Oppo, Vivo et certains Samsung, le système tue automatiquement les applications en arrière-plan pour économiser la batterie. Cela coupe le suivi GPS sans prévenir.\n\nSuivez les étapes ci-dessous selon la marque de votre téléphone."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             XIAOMI / Redmi / POCO (MIUI)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:layout_marginBottom="10dp">

            <!-- Header cliquable -->
            <LinearLayout
                android:id="@+id/cardHeaderXiaomi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 Xiaomi / Redmi / POCO  (MIUI)"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:tag="arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="13sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <!-- Body (masqué par défaut) -->
            <LinearLayout
                android:id="@+id/cardBodyXiaomi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- Étape 1 : Démarrage automatique -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 1 — Autoriser le démarrage automatique"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres\n2. Applications → Gérer les applications\n3. Recherchez GPS Tracker\n4. Démarrage automatique → Activer ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Séparateur -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2a3045"
                    android:layout_marginBottom="12dp"/>

                <!-- Étape 2 : Batterie sans restriction -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 2 — Désactiver l'économie d'énergie"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Batterie\n2. Économie d'énergie par application\n3. Recherchez GPS Tracker\n4. Sélectionner \"Aucune restriction\" ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             HUAWEI / Honor (EMUI / MagicUI)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/cardHeaderHuawei"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 Huawei / Honor  (EMUI / MagicUI)"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:tag="arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="13sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBodyHuawei"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestion du lancement des applications"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Batterie\n2. Lancement des applications\n3. Recherchez GPS Tracker\n4. Désactiver la gestion automatique\n5. Activer manuellement :\n   • Lancement manuel ✅\n   • Lancement secondaire ✅\n   • Fonctionnement en arrière-plan ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             OPPO / Realme (ColorOS)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/cardHeaderOppo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 Oppo / Realme  (ColorOS)"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:tag="arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="13sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBodyOppo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- Étape 1 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 1 — Arrière-plan"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Gestion de la batterie\n2. Recherchez GPS Tracker\n3. Autoriser le fonctionnement en arrière-plan ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2a3045"
                    android:layout_marginBottom="12dp"/>

                <!-- Étape 2 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 2 — Démarrage automatique"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Confidentialité\n2. Autorisations → Démarrage automatique\n3. GPS Tracker → Activer ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             VIVO (FuntouchOS)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:id="@+id/cardHeaderVivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 Vivo  (FuntouchOS)"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:tag="arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="13sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBodyVivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <!-- Étape 1 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 1 — Consommation arrière-plan"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Batterie\n2. Consommation d'énergie élevée en arrière-plan\n3. GPS Tracker → Autoriser ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#2a3045"
                    android:layout_marginBottom="12dp"/>

                <!-- Étape 2 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Étape 2 — Démarrage automatique"
                    android:textSize="13sp"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Plus de paramètres\n2. Autorisations → Démarrage automatique\n3. GPS Tracker → Activer ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════════════════
             SAMSUNG (One UI)
             ══════════════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1f2e"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/cardHeaderSamsung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📱 Samsung  (One UI)"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

                <TextView
                    android:tag="arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶"
                    android:textSize="13sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardBodySamsung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Généralement moins restrictif — à faire uniquement si le GPS s'arrête"
                    android:textSize="12sp"
                    android:textColor="#f59e0b"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Paramètres → Batterie\n2. Limites d'utilisation en arrière-plan\n3. Vérifiez que GPS Tracker N'EST PAS dans :\n   • \"Apps en veille profonde\" ❌\n   • \"Non surveillées\" ❌\n4. Si oui → appuyez sur l'app → Retirer de la liste ✅"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── Note de bas de page ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Ces paramètres varient selon la version de votre système. Si vous ne trouvez pas un menu, cherchez \"GPS Tracker\" dans la barre de recherche des Paramètres."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="32dp"/>

    </LinearLayout>
</ScrollView>
