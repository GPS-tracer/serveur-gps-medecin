rules_version = '2';

// Règles Firebase Storage — GPS Tracker
// Utilisé uniquement pour l'upload du logo de société (register-entreprise.js).
// Chemin : logos/{userId}/{fileName}
service firebase.storage {
  match /b/{bucket}/o {

    match /logos/{userId}/{fileName} {
      // Lecture publique : les logos s'affichent sur le dashboard sans
      // exiger une authentification côté client (simple image statique).
      allow read: if true;

      // Écriture : uniquement le propriétaire du compte, sur son propre
      // dossier, et uniquement des images de moins de 5 Mo.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Tout le reste du bucket est fermé par défaut.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
