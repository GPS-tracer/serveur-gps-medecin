{
  "name": "gps-tracker",
  "version": "1.0.0",
  "description": "GPS Tracker with Firebase",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -c tailwind.config.js -i ./dashboard/tailwind-input.css -o ./dashboard/tailwind-output.css --minify",
    "build:css:vitrine": "tailwindcss -c tailwind.config.vitrine.js -i ./vitrine-tailwind-input.css -o ./vitrine-tailwind-output.css --minify",
    "build:css:all": "npm run build:css && npm run build:css:vitrine",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./dashboard/tailwind-input.css -o ./dashboard/tailwind-output.css --watch"
  },
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "axios": "^1.6.8"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "@tailwindcss/forms": "^0.5.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
